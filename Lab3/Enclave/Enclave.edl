/*
 * ЛР3. Описание интерфейса анклава на языке EDL (Enclave Description Language).
 *
 * Секция trusted содержит ECALL-функции — точки входа, которые незащищённое
 * клиентское приложение может вызвать внутри анклава. При сборке SGX-инструменты
 * (sgx_edger8r) генерируют по этому файлу прокси/мосты:
 *   - Enclave_t.h / Enclave_t.c  — на стороне анклава,
 *   - Enclave_u.h / Enclave_u.c  — на стороне приложения.
 *
 * ecall_get_record копирует во внешний буфер строку таблицы с заданным индексом.
 * Сама таблица (защищаемые данные) объявлена и хранится ВНУТРИ анклава
 * (см. Enclave.cpp) и в открытом виде в клиентском приложении недоступна.
 */
enclave {
    trusted {
        /*
         * index    — запрашиваемый номер записи в таблице;
         * out_buf  — буфер приложения, куда копируется строка ([out] — только вывод);
         * buf_len  — размер буфера out_buf в байтах;
         * возврат  — длина записанной строки, либо -1 если индекс вне диапазона.
         */
        public int ecall_get_record(int index,
                                    [out, size=buf_len] char* out_buf,
                                    size_t buf_len);

        /* Возвращает количество записей в защищённой таблице. */
        public int ecall_get_count(void);

        /*
         * Добавляет новую запись в защищённую таблицу ВНУТРИ анклава.
         * text   — строка, приходящая снаружи ([in, string] — копируется внутрь
         *          анклава, после ECALL в trusted-памяти остаётся только копия);
         * возврат — индекс добавленной записи, либо -1 если таблица заполнена.
         * Примечание: данные живут только в памяти текущего запущенного анклава
         * (на время жизни процесса App.exe) — между отдельными запусками не
         * сохраняются, т.к. sealing (шифрование на диск) в лабораторной работе
         * не реализован (см. доп. задание SealUnseal).
         */
        public int ecall_add_record([in, string] const char* text);
    };
};
